// Bundels: DarcyForchheimer met alleen het kwadratische deel.
// dp = 0.5*rho*f*t*U^2 op de cel-U. In de run is de drukval lager dan deze
// formule (factor ~0.6) omdat de cel-U achterblijft bij de flux over 2-3 cellen
// (zie NOTES); f is gekalibreerd op de gemeten drukval en dus meshafhankelijk.
// e1 = bundelnormaal; dwars op de normaal 10x zo hoog.

porousL
{
    type            explicitPorositySource;

    explicitPorositySourceCoeffs
    {
        cellZone        bundleL;

        type            DarcyForchheimer;

        d   (0 0 0);
        f   (84 840 840);

        coordinateSystem
        {
            type    cartesian;
            origin  (0 0 0);
            coordinateRotation
            {
                type    axesRotation;
                e1      (0.866025 0 -0.5);
                e3      (0 1 0);
            }
        }
    }
}

porousR
{
    $porousL;

    explicitPorositySourceCoeffs
    {
        $../porousL/explicitPorositySourceCoeffs;

        cellZone        bundleR;

        coordinateSystem
        {
            type    cartesian;
            origin  (0 0 0);
            coordinateRotation
            {
                type    axesRotation;
                e1      (0.866025 0 0.5);
                e3      (0 1 0);
            }
        }
    }
}

// Condensatie: stoomzijde op vaste temperatuur, Q = htc*Av*(Ta - T) per m3.
// htc*Av = 8100 W/m3/K, gekalibreerd op ~12 MW bij 500 m3/s.

heatL
{
    type            heatTransfer;

    select          cellZone;
    cellZone        bundleL;

    semiImplicit    yes;

    Ta              323;

    Av              100;

    heatTransferCoefficientModel constant;

    htc             81;
}

heatR
{
    $heatL;

    cellZone        bundleR;
}

// Fan: ronde drukverhoging met swirl, per fan in de lijst `fans`.
// dp(Q) = dp0*(1 - (Q/Qmax)^2); axiale kracht dp/t.
// Swirl volgt uit Euler: Vtheta = dp/(rho*Omega*r), dus krachtdichtheid
// Uz*dp/(Omega*r*t), zodat koppel*Omega = dp*Q.
// dp is onderrelaxeerd (dpRelax): dat is ook de opstart vanuit stilstand.

fan
{
    type            coded;

    select          all;

    field           U;

    codeInclude
    #{
        #include "fvcReconstruct.H"
    #};

    codeAddRhoSup
    #{
        const List<vector> fans({vector(0, 0, 0)});
        const scalar R = 4.55, rHub = 1.5;
        const scalar zLow = 44.5, zHigh = 45.0;
        const scalar dp0 = 250, Qmax = 800, Omega = 7.0;
        const scalar dpRelax = 0.1;
        static scalarList dpOld(fans.size(), scalar(0));

        const vector ez(0, 0, 1);
        const scalar area = constant::mathematical::pi*(sqr(R) - sqr(rHub));
        // Debiet uit de flux: de cel-U in de krachtzone wijkt ~25% af van de massastroom
        const surfaceScalarField& phi =
            mesh().lookupObject<surfaceScalarField>("phi");
        const volVectorField U(fvc::reconstruct(phi)/rho);
        const vectorField& C = mesh().C();
        const scalarField& V = mesh().V();
        vectorField& Su = eqn.source();

        forAll(fans, fanI)
        {
            DynamicList<label> cells;
            scalar vol = 0, intUz = 0;

            forAll(C, celli)
            {
                const vector d = C[celli] - fans[fanI];
                const scalar r = sqrt(sqr(d.x()) + sqr(d.y()));

                if (C[celli].z() > zLow && C[celli].z() < zHigh && r > rHub && r < R)
                {
                    cells.append(celli);
                    vol += V[celli];
                    intUz += V[celli]*U[celli].z();
                }
            }

            reduce(vol, sumOp<scalar>());
            reduce(intUz, sumOp<scalar>());

            const scalar t = vol/area;
            const scalar Q = intUz/t;
            const scalar dpCurve = dp0*max(1 - sqr(max(Q, 0)/Qmax), 0);
            const scalar dp = dpOld[fanI] + dpRelax*(dpCurve - dpOld[fanI]);
            dpOld[fanI] = dp;

            forAll(cells, i)
            {
                const label celli = cells[i];
                vector d = C[celli] - fans[fanI];
                d.z() = 0;
                const scalar r = mag(d);
                const vector thetaHat = (ez ^ d)/r;

                Su[celli] -= V[celli]*dp/t*ez;
                Su[celli] -=
                    V[celli]*max(U[celli].z(), 0)*dp/(Omega*r*t)*thetaHat;
            }

            Info<< "fan " << fanI << " Q = " << Q << " dp = " << dp
                << " t = " << t << endl;
        }
    #};
}

