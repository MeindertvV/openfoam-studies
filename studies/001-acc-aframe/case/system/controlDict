FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          fluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2000;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


functions
{
    #includeFunc residuals(p_rgh, U, h, k, epsilon)

    bundleTL
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        select          cellZone;
        cellZone        bundleL;
        operation       volIntegrate;
        fields          (T);
    }

    bundleTR
    {
        $bundleTL;
        cellZone        bundleR;
    }

    fluxTSides
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        select          patch;
        patch           sides;
        operation       sum;
        weightField     phi;
        fields          (T);
    }

    fluxTTop
    {
        $fluxTSides;
        patch           top;
    }

    massSides
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        select          patch;
        patch           sides;
        operation       sum;
        fields          (phi);
    }

    massTop
    {
        $massSides;
        patch           top;
    }
}

