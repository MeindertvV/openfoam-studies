FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 288;

boundaryField
{
    ground
    {
        type            zeroGradient;
    }

    structure
    {
        type            zeroGradient;
    }

    "(sides|top)"
    {
        type            inletOutlet;
        inletValue      uniform 288;
        value           uniform 288;
    }
}

