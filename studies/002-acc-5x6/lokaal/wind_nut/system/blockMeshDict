FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

vertices
(
    (-240 -240   0) ( 360 -240   0) ( 360  240   0) (-240  240   0)
    (-240 -240 240) ( 360 -240 240) ( 360  240 240) (-240  240 240)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (100 80 40) simpleGrading (1 1 1)
);

boundary
(
    ground
    {
        type wall;
        faces ((0 3 2 1));
    }
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    sides
    {
        type patch;
        faces ((0 1 5 4) (3 7 6 2));
    }
    top
    {
        type patch;
        faces ((4 5 6 7));
    }
);

