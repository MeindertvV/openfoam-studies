// Bundels als cellZone op celmiddelpunt: geen snapping, dus trapjes maar
// goede cellen. Werkt ongewijzigd voor meer units.

actions
(
    {
        name    bundleLCells;
        type    cellSet;
        action  new;
        source  surfaceToCell;
        file    "$FOAM_CASE/constant/geometry/bundleL.stl";
        outsidePoints ((150.1 150.1 20.1));
        useSurfaceOrientation true;
        includeCut      false;
        includeInside   true;
        includeOutside  false;
        nearDistance    -1;
        curvature       -100;
    }
    {
        name    bundleL;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     bundleLCells;
    }
    {
        name    bundleRCells;
        type    cellSet;
        action  new;
        source  surfaceToCell;
        file    "$FOAM_CASE/constant/geometry/bundleR.stl";
        outsidePoints ((150.1 150.1 20.1));
        useSurfaceOrientation true;
        includeCut      false;
        includeInside   true;
        includeOutside  false;
        nearDistance    -1;
        curvature       -100;
    }
    {
        name    bundleR;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     bundleRCells;
    }
);

