FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0.01;
    }

    ph_rgh
    {
        $p_rgh;
        relTol          0;
    }

    "(rho|U|h|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    "(rho|U|h|k|epsilon)Final"
    {
        $U;
        relTol          0.1;
    }
}

PIMPLE
{
    hydrostaticInitialisation yes;

    momentumPredictor yes;
    nOuterCorrectors  1;
    nCorrectors       2;
    nNonOrthogonalCorrectors 0;

    // Lokale tijdstap: begrenst rAU in stilstaande lucht, waar een
    // stationaire matrix geen diagonaal overhoudt.
    maxCo             0.7;
    rDeltaTSmoothingCoeff 0.05;
    rDeltaTDampingCoeff 0.5;
    maxDeltaT         0.2;
}

