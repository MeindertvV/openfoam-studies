FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          fluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime        600;

deltaT          1;

writeControl    timeStep;

writeInterval        100;

purgeWrite        2;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


libs ("libatmosphericModels.so");

functions
{
    minmax
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        fields          (k epsilon nut T p_rgh);
        writeFields     no;
        select          all;
        operation       max;
        writeLocation   yes;
        writeControl    timeStep;
        writeInterval   1;
        log             no;
    }
    #includeFunc residuals(p_rgh, U, h, k, epsilon)

    bundleTL
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        writeFields     false;
        select          cellZone;
        cellZone        bundleL;
        operation       volIntegrate;
        fields          (T);
    }

    bundleTR
    {
        $bundleTL;
        cellZone        bundleR;
    }
}

