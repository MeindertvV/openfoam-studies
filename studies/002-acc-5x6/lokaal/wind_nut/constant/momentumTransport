FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType RAS;

RAS
{
    model           kEpsilon;

    turbulence      on;

    printCoeffs     on;

    // Stilstaande lucht: zonder ondergrens loopt epsilon naar 0 en nut naar 1e7
    kMin            1e-4;
    epsilonMin      1e-5;
}


