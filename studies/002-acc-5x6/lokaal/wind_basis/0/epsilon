FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    ground
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }

    structure
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }

    inlet
    {
        type            atmBoundaryLayerInletEpsilon;
        flowDir         (1 0 0);
        zDir            (0 0 1);
        Uref            9.0;
        Zref            45.0;
        z0              uniform 0.1;
        zGround         uniform 0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.012;
        value           uniform 0.012;
    }

    "(sides|top)"
    {
        type            zeroGradient;
    }
}

