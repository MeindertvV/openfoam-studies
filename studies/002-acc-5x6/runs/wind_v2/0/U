FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    ground
    {
        type            noSlip;
    }

    structure
    {
        type            noSlip;
    }

    inlet
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            ablRamp;
        code
        #{
            const scalar z0 = 0.1, Uref = 9.0, Zref = 45.0;
            const scalar s = min(this->db().time().value()/100.0, 1.0);
            const scalarField z(max(patch().Cf().component(vector::Z), scalar(0)));
            const scalarField Ux(s*Uref*log((z + z0)/z0)/log((Zref + z0)/z0));
            operator==(Ux*vector(1, 0, 0));
        #};
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    "(sides|top)"
    {
        type            slip;
    }
}

