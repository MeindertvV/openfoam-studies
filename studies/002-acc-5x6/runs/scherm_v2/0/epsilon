FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    ground
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }

    structure
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }

    inlet
    {
        // ABL-profiel, met nut begrensd op 5 m2/s via epsilon >= Cmu k^2/nutMax.
        type            codedFixedValue;
        value           uniform 0.026;
        name            ablEpsCap;
        code
        #{
            const scalar z0 = 0.1, Uref = 9.0, Zref = 45.0, kappa = 0.41, Cmu = 0.09, nutMax = 5;
            const scalar us = kappa*Uref/log((Zref + z0)/z0);
            const scalar k = sqr(us)/sqrt(Cmu);
            const scalarField z(max(patch().Cf().component(vector::Z), scalar(0)));
            operator==(max(pow3(us)/(kappa*(z + z0)), Cmu*sqr(k)/nutMax));
        #};
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.026;
        value           uniform 0.026;
    }

    "(sides|top)"
    {
        type            zeroGradient;
    }
}

