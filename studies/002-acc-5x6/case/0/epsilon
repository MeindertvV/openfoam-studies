FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    ground
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }

    structure
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }

    "(inlet|outlet|sides|top)"
    {
        type            inletOutlet;
        inletValue      uniform 0.01;
        value           uniform 0.01;
    }
}

