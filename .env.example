# Kopieer naar .env. .env staat in .gitignore en komt nooit in git.
# Hostnaam, kernen en SSH-opties van de actieve VM komen uit .azjob (geschreven door az_up.sh).

# Lokaal
OPENFOAM_BASHRC=/opt/openfoam11/etc/bashrc

# Tijdelijke VM
AZ_REGION=swedencentral
AZ_SSH_USER=azureuser
AZ_SSH_KEY=$HOME/.ssh/openfoam_azure
AZ_DISK_GB=64

# Map op de VM; hieronder komen scripts/, post/ en studies/
AZ_REMOTE_ROOT=/home/azureuser/of

# Datatransport; alleen rsync is ingebouwd
AZ_TRANSFER=rsync

# Slurm op de VM; deze partitie maakt cloud-init.yaml aan
AZ_PARTITION=hpc
# Leeg laten: op de VM niet nodig
AZ_ACCOUNT=
AZ_QOS=

# OpenFOAM op de VM
AZ_OF_LOAD='source /opt/openfoam11/etc/bashrc'
# MPI-start in de job; enkele quotes houden $SLURM_NTASKS letterlijk
AZ_MPI_CMD='mpirun -np $SLURM_NTASKS'
# Post-job: extra laden en de pvbatch-aanroep; op de VM is geen beeldscherm
AZ_POST_LOAD=
AZ_PV_CMD='xvfb-run -a pvbatch --force-offscreen-rendering'
